# Gemini API 키를 이 파일에 적고 `.env`로 복사한 뒤 앱을 재시작하세요.
# `.env`는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# 키를 채팅/코드/로그에 붙여넣지 마세요.

GEMINI_API_KEY= 

# 선택: 모델명을 바꾸고 싶을 때만 주석을 풀고 사용하세요.
# VLM_MODEL=gemini-3-flash-preview

# 선택: 서버 운영 설정
# MOSAIC_INVITE_CODE=팀에서_정한_초대코드
# MOSAIC_VLM_RPM=90
# MOSAIC_MAX_SECONDS=900
# MOSAIC_SEG_MODEL=yolo11m-seg.pt
# MOSAIC_IMGSZ=960
# MOSAIC_FACE_MULTISCALE=1
# MOSAIC_HEAD_POSE=1
# MOSAIC_REPLAY=1
# MOSAIC_DEBUG=1
# 얼굴 개인별 실루엣 랜드마크. 0이면 고정 얼굴형만 쓴다(빠름).
# MOSAIC_FACE_MESH=1
# 번호판 전용 검출기. 0이면 VLM 앵커만 쓴다.
# MOSAIC_PLATE_DET=1
# MOSAIC_PLATE_CONF=0.35
# MOSAIC_PLATE_EVERY=2
# 주소·문서 글자 정제(EAST). 0이면 끈다.
# MOSAIC_TEXT_DET=1
# MOSAIC_TEXT_CONF=0.6
